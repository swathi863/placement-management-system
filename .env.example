# Production Environment Variables for Railway / PostgreSQL Deployment

# Database Connection (PostgreSQL provided by Railway or external Cloud Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/placement_db

# Security
SECRET_KEY=your-super-secret-production-key-here

# Mail Configuration (Optional - for Email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=Placement Office <your-email@gmail.com>

# Server Port (Auto-assigned by Railway)
PORT=5000
